  "criteria_catalog": [
    {
      "criterion_id": "current_input_response",
      "kind": "fulfillment",
      "description": "The final output materially responds to the current user input."
    },
    {
      "criterion_id": "setting_continuity",
      "kind": "fulfillment",
      "description": "The final output preserves source-backed prior events, commitments, answers, and current setting."
    },
    {
      "criterion_id": "knowledge_boundary",
      "kind": "fulfillment",
      "description": "Each character acts only on knowledge supported for that character."
    },
    {
      "criterion_id": "identity_uncertainty",
      "kind": "fulfillment",
      "description": "An unproven alias or hidden identity remains unresolved instead of being merged or split by guess."
    },
    {
      "criterion_id": "already_realized_repetition",
      "kind": "violation",
      "description": "The final output repeats a source-backed realized event as if it were happening for the first time."
    },
    {
      "criterion_id": "unsupported_assertion",
      "kind": "violation",
      "description": "The final output invents a fact, identity, memory, event, or relationship not supported by the supplied sources."
    },
    {
      "criterion_id": "secret_leakage",
      "kind": "violation",
      "description": "A character gains protected information without a source establishing that knowledge."
    },
    {
      "criterion_id": "user_agency_override",
      "kind": "violation",
      "description": "The final output decides the user or player character's action, feeling, or commitment without authority."
    },
    {
      "criterion_id": "relationship_jump",
      "kind": "violation",
      "description": "The final output asserts a relationship transition that is not supported by the supplied sources."
    },
    {
      "criterion_id": "premature_closure",
      "kind": "violation",
      "description": "The final output expands a local resolution into an unsupported ending of the wider story."
    },
    {
      "criterion_id": "forced_difference",
      "kind": "violation",
      "description": "Guidance changes a no-support turn despite having no eligible source-backed item."
    }
  ],
